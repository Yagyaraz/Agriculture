            font-size: 0.7rem;
            padding: 4px 8px;
            border-radius: 20px;
            background: rgba(46, 204, 113, 0.2);
            color: #27ae60;
            margin-left: 10px;
        }

    /* Glass Container */
    .weather-container {
        background: linear-gradient(135deg, #9ed7aa, #74c69d, #b7e4c7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);

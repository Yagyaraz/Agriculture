</script>

<script>
    async function getWeather() {
        const cityInput = document.getElementById("cityInput");
        const city = cityInput.value || "Kathmandu";
        const apiKey = "30bc825522a1e4c3c7ed7d70f230b478";

        try {
            // CURRENT WEATHER
            const currentRes = await fetch(
                `https://api.openweathermap.org/data/2.5/weather?q=${city}&units=metric&appid=${apiKey}`
            );
            if (!currentRes.ok) throw new Error("City not found");
            const current = await currentRes.json();

            // FORECAST
            const forecastRes = await fetch(
                `https://api.openweathermap.org/data/2.5/forecast?q=${city}&units=metric&appid=${apiKey}`
            );
            const forecast = await forecastRes.json();

            // UI Update: Current
            document.getElementById("location").innerHTML = `<i class="fas fa-location-dot me-2"></i>${current.name}, ${current.sys.country}`;
            document.getElementById("temp").textContent = Math.round(current.main.temp) + "°";
            document.getElementById("desc").textContent = current.weather[0].description;
            document.getElementById("feels").textContent = "Feels like " + Math.round(current.main.feels_like) + "°";
            document.getElementById("wind").textContent = current.wind.speed + " m/s";
            document.getElementById("humidity").textContent = current.main.humidity + "%";
            document.getElementById("visibility").textContent = (current.visibility / 1000) + " km";
            document.getElementById("pressure").textContent = current.main.pressure + " hPa";
                

            // UI Update: Hourly
            let hourlyHTML = "";
            forecast.list.slice(0, 8).forEach(item => {
                const time = new Date(item.dt * 1000).getHours();
                const icon = item.weather[0].main === 'Clear' ? 'sun' : 'cloud';
                hourlyHTML += `
                    <div class="hour-item">
                        <p class="small mb-2">${time}:00</p>
                        <i class="fas fa-${getIcon(item.weather[0].main)} mb-2 text-info"></i>
                        <p class="fw-bold mb-0">${Math.round(item.main.temp)}°</p>
                    </div>
                `;
            });
            document.getElementById("hourly").innerHTML = hourlyHTML;

            // UI Update: Daily (Grouping by 12:00 PM for accuracy)
            let dailyHTML = "";
            const dailyData = forecast.list.filter(item => item.dt_txt.includes("12:00:00"));

            dailyData.forEach(item => {
                const date = new Date(item.dt * 1000);
                const dayName = date.toLocaleDateString('en-US', { weekday: 'short' });
                dailyHTML += `
                    <div class="day-row">
                        <span style="width: 50px">${dayName}</span>
                        <i class="fas fa-${getIcon(item.weather[0].main)} text-info"></i>
                        <span class="small opacity-75">${item.weather[0].description}</span>
                        <span class="fw-bold">${Math.round(item.main.temp)}°</span>
                    </div>
                `;
            });
            document.getElementById("daily").innerHTML = dailyHTML;
            cityInput.value = ""; // Clear input

        } catch (error) {
            alert(error.message);
        }
    }

    function getIcon(condition) {
        const map = {
            'Clear': 'sun',
            'Clouds': 'cloud',
            'Rain': 'cloud-showers-heavy',
            'Snow': 'snowflake',
            'Thunderstorm': 'bolt',
            'Drizzle': 'cloud-rain'
        };
        return map[condition] || 'cloud';
    }

    // Initial Load
    getWeather();
</script>

<script>
              const hourlyContainer = document.getElementById("hourly");

    let direction = 1; // 1 = → right, -1 = → left
    let speed = 0.6;
    let isPaused = false;

    function autoScroll() {
        if (!isPaused) {
            const maxScroll =
                hourlyContainer.scrollWidth - hourlyContainer.clientWidth;

            hourlyContainer.scrollLeft += speed * direction;

            // Use >= and <= with small buffer (important fix)
            if (hourlyContainer.scrollLeft >= maxScroll - 1) {
                direction = -1; // go left
            }
            else if (hourlyContainer.scrollLeft <= 1) {
                direction = 1; // go right
            }
        }

        requestAnimationFrame(autoScroll);
    }

    // Pause on hover
    hourlyContainer.addEventListener("mouseenter", () => {
        isPaused = true;
    });

    // Resume on leave
    hourlyContainer.addEventListener("mouseleave", () => {
        isPaused = false;
    });

    autoScroll();
</script>


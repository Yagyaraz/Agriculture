<script>
    function updateClock() {
        const now = new Date();

        // TIME
        const h = String(now.getHours()).padStart(2, '0');
        const m = String(now.getMinutes()).padStart(2, '0');
        const s = String(now.getSeconds()).padStart(2, '0');

        document.getElementById("time").textContent = `${h}:${m}:${s}`;

        // NEPALI STYLE DATE (locale based)
        const options = {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        };

        const nepaliDate = now.toLocaleDateString('ne-NP', options);
        document.getElementById("date").textContent = nepaliDate;
    }

    setInterval(updateClock, 1000);
    updateClock();
</script>

<script>

const apiKey = "30bc825522a1e4c3c7ed7d70f230b478";
let timeout;

async function getWeather(cityFromClick = null) {

    const cityInput = document.getElementById("cityInput");
    const city = cityFromClick || cityInput.value.trim() || "Kathmandu";

    try {

        const currentRes = await fetch(
            `https://api.openweathermap.org/data/2.5/weather?q=${city}&units=metric&appid=${apiKey}`
        );

        if (!currentRes.ok) throw new Error("City not found");

        const current = await currentRes.json();

        const forecastRes = await fetch(
            `https://api.openweathermap.org/data/2.5/forecast?q=${city}&units=metric&appid=${apiKey}`
        );

        const forecast = await forecastRes.json();

        document.getElementById("location").innerHTML =
            `<i class="fas fa-location-dot me-2"></i>${current.name}, ${current.sys.country}`;

        document.getElementById("temp").textContent =
            Math.round(current.main.temp) + "°";

        document.getElementById("desc").textContent =
            current.weather[0].description;

        document.getElementById("feels").textContent =
            "Feels like " + Math.round(current.main.feels_like) + "°";

        document.getElementById("wind").textContent =
            current.wind.speed + " m/s";

        document.getElementById("humidity").textContent =
            current.main.humidity + "%";

        document.getElementById("visibility").textContent =
            (current.visibility / 1000) + " km";

        document.getElementById("pressure").textContent =
            current.main.pressure + " hPa";

        cityInput.value = "";
        document.getElementById("suggestions").innerHTML = "";

    } catch (error) {
        alert(error.message);
    }
}

// ---------------- AUTOCOMPLETE ----------------
async function searchCities() {

    const input = document.getElementById("cityInput").value.trim();
    const box = document.getElementById("suggestions");

    if (input.length < 2) {
        box.innerHTML = "";
        return;
    }

    clearTimeout(timeout);

    timeout = setTimeout(async () => {

        const url =
            `https://api.openweathermap.org/geo/1.0/direct?q=${input}&limit=10&appid=${apiKey}`;

        const res = await fetch(url);
        const data = await res.json();

        box.innerHTML = "";

        data.forEach(item => {

            const div = document.createElement("div");

            div.textContent = `${item.name}, ${item.country}`;

            div.onclick = () => {
                document.getElementById("cityInput").value =
                    item.name;

                box.innerHTML = "";

                getWeather(item.name);
            };

            box.appendChild(div);
        });

    }, 300);
}

// initial load

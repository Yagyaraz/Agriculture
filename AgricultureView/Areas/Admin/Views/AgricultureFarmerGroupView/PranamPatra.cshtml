@model AgricultureFarmerGroupViewModel
@using AgricultureView.Utility
@inject AgricultureView.Utility.IGlobalVeriable _global
@inject IUtility _Utility
@{
    ViewData["Title"] = "PranamPatra";
    var org = await _Utility.GetOfficeDetail();
    var orgname = org.PalikaName;
}
<!DOCTYPE html>
<html lang="ne">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>कृषक समूह दर्ता प्रमाण-पत्र</title>
    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"> *@
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Nepali:wght@400;500;700;900&display=swap"
          rel="stylesheet">
    <style>
        :root {
            --primary-green: #1a4d2e;
            --dark-green: #0d2b1a;
            --gold: #b8860b;
            --light-gold: #fcf4d9;
            --text-gray: #333;
            --white: #ffffff;
        }

        * {
            box-sizing: border-box;
            -webkit-print-color-adjust: exact;
        }
        body {
            font-family: 'Noto Sans Nepali', 'Roboto', sans-serif;
            background: #fff;
            color: #000;
            line-height: 1.5;
            font-size: 16px;
        }

        

        .btn-print {
            background: var(--gold);
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 5px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.3s;
        }

            .btn-print:hover {
                background: #966d08;
            }

        /* Certificate Container */
        .cert-container {
            width: 850px;
            background: var(--white);
            padding: 100px 50px;
            position: relative;
            border: 15px solid var(--primary-green);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
            overflow: hidden;
            background-image: radial-gradient(circle, #ffffff 0%, #fdfdfd 100%);
        }

        /* Elegant Inner Border */
        .cert-inner-border {
            border: 2px solid var(--gold);
            height: 100%;
            width: 100%;
            padding: 30px;
            position: relative;
        }

        /* Watermark */
        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            opacity: 0.04;
            width: 400px;
            pointer-events: none;
            z-index: 0;
        }

        /* Header Layout */
        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            text-align: center;
            margin-bottom: 2px;
            position: relative;
            z-index: 1;
        }

        .header-center h1 {
            color: #d90429;
            /* Official Red for Nepal Gov */
            font-size: 16px;
            margin: 0;
            line-height: 1.2;
        }

        .header-center h2 {
            color: var(--primary-green);
            font-size: 24px;
            margin: 0;
        }

        .header-center p {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
        }

        .logo {
            width: 90px;
            height: auto;
        }

        /* Title Banner */
        .title-banner {
            text-align: center;
            margin: 2px 0;
            position: relative;
        }

            .title-banner h3 {
                background: var(--primary-green);
                color: white;
                display: inline-block;
                padding: 2px 60px;
                font-size: 28px;
                border-radius: 50px;
                border: 3px solid var(--gold);
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            }

        /* Meta Info */
        .meta-info {
            display: flex;
            justify-content: space-between;
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 2px;
            border-bottom: 1px solid #eee;
            padding-bottom: 1px;
        }

        /* Main Content */
        .cert-content {
            font-size: 19px;
            line-height: 1.8;
            text-align: justify;
            margin-bottom: 3px;
            text-indent: 50px;
        }

        .highlight {
            color: var(--primary-green);
            font-weight: 800;
            border-bottom: 2px solid var(--gold);
        }

        /* Details Grid */
        .details-grid {
            /* display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5px; */
            background: var(--light-gold);
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 30px;
        }

        .detail-item {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 2px;
            margin-top: 8px;
        }

        .detail-label {
            font-weight: 700;
            color: var(--primary-green);
            font-size: 15px;
        }

        .detail-value {
            font-size: 17px;
            border-bottom: 1px dotted var(--gold);
        }

        /* Signatures */
        .signature-section {
            display: flex;
            justify-content: space-between;
            margin-top: 80px;
            padding: 0 20px;
        }

        .sig-box {
            text-align: center;
            width: 200px;
        }

        .sig-line {
            border-top: 2px solid #333;
            margin-bottom: 5px;
        }

        /* Stamp */
        .official-stamp {
            position: absolute;
            bottom: 150px;
            left: 50%;
            transform: translateX(-50%) rotate(-10deg);
            width: 120px;
            height: 120px;
            border: 4px double rgba(26, 77, 46, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 800;
            color: rgba(26, 77, 46, 0.2);
            text-align: center;
        }

        .instruction-box {
            margin-top: 3px;
            font-size: 13px;
            color: #555;
            background: #fdfdfd;
            padding: 15px;
            border-left: 5px solid var(--gold);
        }

        footer {
            margin-top: 20px;
            color: #777;
            font-size: 14px;
        }

        /* Print Logic */

    @@media print {

    @@page {
        size: A4 portrait;
        margin: 0;
    }

    body {
        margin: 0;
        padding: 0;
        background: #fff;
    }

    /* Hide everything */
    body * {
        visibility: hidden;
    }

    /* Show only print section */
    #print-section,
    #print-section * {
        visibility: visible;
    }

    #print-section .header-section {
    visibility: visible !important;
    display: flex !important;
    justify-content: space-between;
    align-items: center;
}

/* Fix logos not appearing */
#print-section .header-section img {
    visibility: visible !important;
    display: block !important;
    max-width: 90px;
}

/* Ensure center text shows */
#print-section .header-center {
    visibility: visible !important;
    text-align: center;
    flex: 1;

}
    /* Fix position to remove sidebar/header spacing */
    #print-section {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: auto;
        margin: 0;
        padding: 20px;
        box-sizing: border-box;
        background: white;
    }

    /* Clean certificate layout */
    .cert-container {
        width: 100% !important;
        box-shadow: none !important;
        border-width: 20px;
    }

    /* Remove buttons and UI */
    .btn-print,
    .no-print,
    header,
    nav,
    footer,
    aside {
        display: none !important;
    }

    /* Prevent breaking */
    .cert-container,
    .cert-inner-border,
    .content-section,
    .signature-section,
    .instruction-box {
        page-break-inside: avoid;
    }

    /* Keep colors */
    * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }
}
    </style>
</head>

<body>
    <div class="d-flex justify-content-center align-items-center">
    <div>
            <button class="btn-print mt-4" onclick="window.print()">🖨️ यो प्रमाण-पत्र प्रिन्ट गर्नुहोस् (Print Certificate)</button>
    <div class="cert-container" id="print-section">
        <div class="cert-inner-border">
            <!-- Header -->
            <!-- <div class="header d-flex justify-content-center align-items-center">
                <img src="./image/logo.png" alt="Nepal Government" class="logo justify-content-right">
                <div class="text-center mx-3">
                    <h5 class="title-nepali">सिरीजङ्घा गाउँपालिका</h5>
                    <h2 class="subtitle-nepali">गाउँ कार्यपालिकाको कार्यालय</h2>
                    <p class="address">तेल्लोक, ताप्लेजुङ</p>
                    <p class="address">कोशी प्रदेश, नेपाल</p>
                </div>
                <img src="./image/Arjunchaupari-logo.png" alt="Local Logo" class="logo justify-content-left">
            </div> -->
            <img src="~/assets/img/nepal_logo.png" class="watermark"
                 alt="watermark">
            <header class="header-section">
                <img src="~/assets/img/nepal_logo.png" class="logo" alt="Nepal Logo">
                <div class="header-center">
                    <h1 class="fw-bold title-nepali">@org.PalikaName</h1>
                        <h2 class="fw-bold py-1 subtitle-nepali">गाउँ कार्यपालिकाको कार्यालय</h2>
                    <p class="address">@org.Address, @org.DistrictName</p>
                    <p class="address">@org.StateName, नेपाल</p>
                </div>
                <img src="~/assets/img/sirijanga_logo.jpg" class="logo" alt="Local Logo">
            </header>

            @* <h1 class="certificate-title">कृषक समूह दर्ता प्रमाण-पत्र</h1> *@
            <div class="title-banner">
                <h3>कृषक समूह दर्ता प्रमाण-पत्र</h3>
            </div>

            <div class="meta-info">
                <span class="ref-info"><strong>दर्ता नं.:</strong>@Model.FirmDartaNo </span>
                <span class="ref-info"><strong>मितिः</strong> @Model.FirmRegDate</span>
            </div>

            <div class="content-section">
                <article class="cert-content">
                    @Model.SamuhaAim उद्देश्यले @org.DistrictName @Model.FirmPalikaName @Model.FirmWardNo
                    @Model.FirmTolName मा संचालित <span class="highlight-text">
                        श्री @Model.FirmName
                    </span> लाई सम्बत @Model.FirmRegDate मा यस
                    कार्यालयको अभिलेखमा दर्ता गरी यो प्रमाण-पत्र प्रदान गरीएको छ।
                </article>

                <div class="details-grid">
                    <div class="detail-item">
                            @{
                                var chairmanName = Model.OfficialsDetailViewModelList
                                .FirstOrDefault(x => x.PostId == 1)?.FullName ?? "";
                            }

                            
                            <span class="detail-label">
                                संचालक/मुख्य ब्यक्तिको नाम थरः
                            </span>
                        <span class="detail-value">श्री @chairmanName (अध्यक्ष)</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">ठेगाना:</span>
                            <span class="detail-value"> @Model.FirmPalikaName, @Model.FirmWardNo @Model.FirmTolName, @org.DistrictName</span>
                    </div>
                    <div class="detail-item">
                                @{
                                    var totalCount = Model.SadsyeMaleCount + Model.SadsyeFemaleCount + Model.SadsyeOtherCount;
                                }
                        <span class="detail-label">सदस्य विवरण:</span>
                        <span class="detail-value">
                                <strong>@totalCount जना</strong> (पुरुष: @Model.SadsyeMaleCount जना, महिला: @Model.SadsyeFemaleCount)
                        </span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">समूहको उद्देश्य:</span>
                            <span class="detail-value">@Model.SamuhaDetails</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">समूहको लगानी (रु. मा):</span>
                            <span class="detail-value">रु. @Model.FirmHitKoshAmt</span>
                    </div>
                </div>
            
           

                <div class="signature-section">
                    <div class="sig-box">
                        <div class="sig-line"></div>
                        <p>फाँटवालाको हस्ताक्षर</p>
                    </div>
                    <div class="sig-box">
                        <div class="sig-line"></div>
                        <p>प्रमुख प्रशासकीय अधिकृत</p>
                    </div>
                </div>

                <div class="instruction-box">
                    <strong>केही महत्वपूर्ण जानकारीहरू:</strong>
                    <ul>
                        <li>यो प्रमाण-पत्र आफ्नो समूह स्थापना भएको ठाउँमा अनिवार्य रूपमा राख्नुपर्नेछ।</li>
                        <li>
                            प्रत्येक आ.व. को वार्षिक कर समाप्त भएको ३ महिना भित्र बुझाई नवीकरण गर्नुपर्नेछ। यसको मान्य अवधि
                            १
                            वर्ष हुनेछ।
                        </li>
                        <li>
                            समूह बन्द गर्नुपरेमा ३५ दिन भित्र लिखित जानकारी दिनुपर्नेछ, अन्यथा समूह चालु नै रहेको मानिनेछ।
                        </li>
                        <li>अन्य कुनै निकायबाट अनुमति लिनुपर्ने भएमा सो लिएर मात्र संचालन गर्नुपर्नेछ।</li>
                        <li>अन्य कुराहरू प्रचलित ऐन र कानुन अनुसार हुनेछन्।</li>
                    </ul>
                </div>

            
        </div>
    </div>
    </div>
        </div>
    </div>

    @* <div class="text-center my-4 no-print">
        <button onclick="window.print()" class="btn btn-success btn-lg">
            🖨️ यो प्रमाण-पत्र प्रिन्ट गर्नुहोस् (Print Certificate)
        </button>
    </div> *@

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>